import tkinter as tk
from tkinter import filedialog, messagebox
from pathlib import Path
import json
from crypto_utils import encode, decode, metadata_for, verify_metadata

def run():
    action = action_var.get()
    mode = mode_var.get()
    shift = int(shift_var.get() or "3")
    compress = compress_var.get()
    decompress = decompress_var.get()
    password = password_var.get().strip() or None

    input_file = filedialog.askopenfilename(title="Select input file")
    if not input_file:
        return

    output_file = filedialog.asksaveasfilename(title="Save output as")
    if not output_file:
        return

    text = Path(input_file).read_text(encoding="utf-8").strip()

    try:
        if action == "encode":
            result, raw = encode(text, mode, shift=shift, compress=compress, password=password)
            Path(output_file).write_text(result, encoding="utf-8")
            meta = metadata_for(input_file, mode, shift, compress, raw, result)
            meta_path = output_file.rsplit(".", 1)[0] + ".json"
            Path(meta_path).write_text(json.dumps(meta, indent=2), encoding="utf-8")
            messagebox.showinfo("Done", f"Saved output and metadata:
{output_file}
{meta_path}")
        else:
            result = decode(text, mode, shift=shift, decompress=decompress, password=password)
            Path(output_file).write_text(result, encoding="utf-8")
            messagebox.showinfo("Done", f"Saved decoded file:
{output_file}")
    except Exception as e:
        messagebox.showerror("Error", str(e))

root = tk.Tk()
root.title("Advanced Encoding / Decoding Tool")

action_var = tk.StringVar(value="encode")
mode_var = tk.StringVar(value="base64")
shift_var = tk.StringVar(value="3")
compress_var = tk.BooleanVar(value=False)
decompress_var = tk.BooleanVar(value=False)
password_var = tk.StringVar(value="")

tk.Label(root, text="Action").grid(row=0, column=0, sticky="w")
tk.Radiobutton(root, text="Encode", variable=action_var, value="encode").grid(row=0, column=1)
tk.Radiobutton(root, text="Decode", variable=action_var, value="decode").grid(row=0, column=2)

tk.Label(root, text="Mode").grid(row=1, column=0, sticky="w")
tk.OptionMenu(root, mode_var, "base64", "base64url", "hex", "caesar", "hash", "aes").grid(row=1, column=1, columnspan=2, sticky="ew")

tk.Label(root, text="Shift").grid(row=2, column=0, sticky="w")
tk.Entry(root, textvariable=shift_var).grid(row=2, column=1, columnspan=2, sticky="ew")

tk.Label(root, text="Password").grid(row=3, column=0, sticky="w")
tk.Entry(root, textvariable=password_var, show="*").grid(row=3, column=1, columnspan=2, sticky="ew")

tk.Checkbutton(root, text="Compress", variable=compress_var).grid(row=4, column=1, sticky="w")
tk.Checkbutton(root, text="Decompress", variable=decompress_var).grid(row=4, column=2, sticky="w")

tk.Button(root, text="Run", command=run).grid(row=5, column=0, columnspan=3, sticky="ew")

root.mainloop()
