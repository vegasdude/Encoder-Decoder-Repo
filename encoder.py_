#!/usr/bin/env python3
import argparse
import base64
import hashlib
import json
import zlib
from datetime import datetime, timezone
from pathlib import Path

def caesar_shift(text, shift):
    out = []
    for ch in text:
        if "a" <= ch <= "z":
            out.append(chr((ord(ch) - 97 + shift) % 26 + 97))
        elif "A" <= ch <= "Z":
            out.append(chr((ord(ch) - 65 + shift) % 26 + 65))
        else:
            out.append(ch)
    return "".join(out)

def encode_text(text, mode, shift=3, compress=False):
    raw = text.encode("utf-8")
    if compress and mode in {"base64", "base64url", "hex"}:
        raw = zlib.compress(raw)

    if mode == "base64":
        encoded = base64.b64encode(raw).decode("ascii")
    elif mode == "base64url":
        encoded = base64.urlsafe_b64encode(raw).decode("ascii")
    elif mode == "hex":
        encoded = raw.hex()
    elif mode == "caesar":
        if compress:
            raise ValueError("Compression is not supported with Caesar cipher")
        encoded = caesar_shift(text, shift)
    elif mode == "hash":
        encoded = hashlib.sha256(raw).hexdigest()
    else:
        raise ValueError("Unsupported mode")

    return encoded, raw

def build_metadata(source_file, mode, shift, compress, raw_bytes, encoded_text):
    return {
        "source_file": source_file,
        "mode": mode,
        "shift": shift,
        "compressed": compress,
        "sha256": hashlib.sha256(raw_bytes).hexdigest(),
        "created_at": datetime.now(timezone.utc).isoformat(),
        "output_length": len(encoded_text),
    }

def main():
    parser = argparse.ArgumentParser(description="Encode text and create JSON metadata")
    parser.add_argument("-i", "--input", required=True)
    parser.add_argument("-o", "--output", required=True)
    parser.add_argument("-m", "--mode", choices=["base64", "base64url", "hex", "caesar", "hash"], default="base64")
    parser.add_argument("--shift", type=int, default=3)
    parser.add_argument("--compress", action="store_true")
    parser.add_argument("--meta", default=None, help="Metadata output JSON file")
    args = parser.parse_args()

    text = Path(args.input).read_text(encoding="utf-8")
    encoded, raw = encode_text(text, args.mode, shift=args.shift, compress=args.compress)

    Path(args.output).write_text(encoded, encoding="utf-8")

    meta_path = args.meta or f"{Path(args.output).stem}.json"
    metadata = build_metadata(args.input, args.mode, args.shift, args.compress, raw, encoded)
    Path(meta_path).write_text(json.dumps(metadata, indent=2), encoding="utf-8")

if __name__ == "__main__":
    main()
