#!/usr/bin/env python3
import argparse
import json
from pathlib import Path
from crypto_utils import encode, decode, metadata_for, verify_metadata

def main():
    parser = argparse.ArgumentParser(description="Advanced encoding/decoding CLI")
    parser.add_argument("action", choices=["encode", "decode"])
    parser.add_argument("-i", "--input", required=True)
    parser.add_argument("-o", "--output", required=True)
    parser.add_argument("-m", "--mode", choices=["base64", "base64url", "hex", "caesar", "hash", "aes"], default="base64")
    parser.add_argument("--shift", type=int, default=3)
    parser.add_argument("--compress", action="store_true")
    parser.add_argument("--decompress", action="store_true")
    parser.add_argument("--password", default=None)
    parser.add_argument("--meta", default=None)
    parser.add_argument("--verify", action="store_true")
    args = parser.parse_args()

    text = Path(args.input).read_text(encoding="utf-8").strip()

    if args.action == "encode":
        result, raw = encode(text, args.mode, shift=args.shift, compress=args.compress, password=args.password)
        Path(args.output).write_text(result, encoding="utf-8")
        meta = metadata_for(args.input, args.mode, args.shift, args.compress, raw, result)
        meta_path = args.meta or f"{Path(args.output).stem}.json"
        Path(meta_path).write_text(json.dumps(meta, indent=2), encoding="utf-8")

    else:
        if args.mode == "hash":
            raise ValueError("Hash cannot be decoded")
        result = decode(text, args.mode, shift=args.shift, decompress=args.decompress, password=args.password)
        Path(args.output).write_text(result, encoding="utf-8")
        if args.verify and args.meta:
            meta = json.loads(Path(args.meta).read_text(encoding="utf-8"))
            ok, actual = verify_metadata(result.encode("utf-8"), meta)
            print(f"Metadata verification: {'OK' if ok else 'FAILED'}")
            if not ok:
                print(f"Expected: {meta.get('sha256')}")
                print(f"Actual:   {actual}")

if __name__ == "__main__":
    main()
